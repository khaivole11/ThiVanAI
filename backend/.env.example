# Defaults an toàn; có thể bỏ khỏi .env nếu chấp nhận giá trị trong Settings.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
LOG_LEVEL=INFO

# Bắt buộc theo từng môi trường triển khai.
FRONTEND_ORIGINS=http://localhost:8443,http://localhost:3000,http://localhost:5173

DATA_DIR=./data
CORPUS_PATH=./data/raw/final_poems_dataset.csv
NORMALIZED_CORPUS_PATH=./data/processed/corpus_normalized.parquet
CORPUS_MANIFEST_PATH=./data/manifests/current.json

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_MODE=embedded
CHROMA_PATH=./data/indexes/chroma
CHROMA_COLLECTION=vietnamese_poems
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
BM25_INDEX_PATH=./data/indexes/bm25/bm25_index.pkl

# Bắt buộc chọn đúng một generator: ollama hoặc openai.
GENERATION_PROVIDER=ollama

# Chỉ bắt buộc khi GENERATION_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Chỉ bắt buộc khi GENERATION_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Persistence: sqlite là default; mongo là optional adapter.
RESULT_STORE=sqlite

# Chỉ bắt buộc khi RESULT_STORE=sqlite.
SQLITE_URL=sqlite:///./data/app.db

# Chỉ bắt buộc khi RESULT_STORE=mongo.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=thi_van_ai

# Các tuning parameter dưới đây có default an toàn trong Settings.
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
RETRIEVAL_EMBEDDING_K=20
RETRIEVAL_BM25_K=20
RETRIEVAL_MAX_CANDIDATE_K=100
RETRIEVAL_ALPHA=0.65
CONTEXT_MAX_CHARACTERS=12000
GENERATION_TEMPERATURE=0.7
GENERATION_MAX_OUTPUT_TOKENS=512
GENERATION_MAX_VALIDATION_RETRIES=3
GENERATION_TIMEOUT_SECONDS=90
GENERATION_TITLE_EXCERPT_CHARACTERS=24
ANALYSIS_TEMPERATURE=0.2
ANALYSIS_MAX_OUTPUT_TOKENS=1600
ANALYSIS_TIMEOUT_SECONDS=90
HISTORY_DEFAULT_PAGE_SIZE=20
HISTORY_MAX_PAGE_SIZE=100
INGEST_BATCH_SIZE=500
FILE_HASH_CHUNK_BYTES=1048576
