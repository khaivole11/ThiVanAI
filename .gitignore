# Dependencies
node_modules/
.pnpm-store/

# Frontend build output and caches
dist/
build/
.vite/
.cache/
coverage/
*.tsbuildinfo

# Environment files and local secrets
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python packaging artifacts
*.egg-info/
.eggs/
pip-wheel-metadata/

